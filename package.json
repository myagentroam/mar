{
  "name": "my-agent-roam",
  "private": true,
  "license": "LicenseRef-MAR-ESAL-1.0",
  "version": "0.11.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm --filter @myagentroam/server... --filter @myagentroam/web-console... --filter @myagentroam/node... build",
    "lint": "prettier --check . && eslint .",
    "typecheck": "pnpm --filter @myagentroam/protocol build && pnpm --filter @myagentroam/code-navigation build && pnpm --filter @myagentroam/agent build && pnpm --filter @myagentroam/server-core build && pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "test:unit": "pnpm --filter @myagentroam/protocol test:unit && pnpm --filter @myagentroam/code-navigation test:unit && pnpm --filter @myagentroam/node test:unit && pnpm --filter @myagentroam/server-core test:unit && pnpm --filter @myagentroam/web-core test:unit && pnpm --filter @myagentroam/agent test:unit && pnpm test:product",
    "start": "pnpm --filter @myagentroam/server start",
    "dev:web": "pnpm --filter @myagentroam/web-console dev",
    "test:e2e": "node --import tsx scripts/test-e2e.mjs",
    "test:integration": "node --import tsx scripts/test-e2e.mjs --integration",
    "test:smoke": "node --import tsx scripts/test-e2e.mjs --smoke",
    "test": "pnpm test:unit && pnpm test:e2e",
    "check:versions": "node scripts/release-artifacts.mjs check-versions",
    "computer-runtime:prepare": "node scripts/prepare-computer-use-runtime.mjs",
    "release:seal-runtime": "node scripts/computer-runtime-artifacts.mjs seal",
    "release:verify-runtime": "node scripts/computer-runtime-artifacts.mjs verify",
    "release:seal-marctl": "node scripts/marctl-release-artifacts.mjs seal",
    "release:verify-marctl": "node scripts/marctl-release-artifacts.mjs verify",
    "release:plan": "node scripts/release-plan.mjs",
    "release:bump-code-navigation": "node scripts/bump-code-navigation-version.mjs",
    "release:bump-marctl": "node scripts/bump-marctl-version.mjs",
    "release:bump-runtime": "node scripts/bump-computer-runtime-version.mjs",
    "release:sbom": "node scripts/create-sbom.mjs",
    "release:notices": "node scripts/create-third-party-notices.mjs",
    "release:verify-common": "node scripts/verify-common-integration.mjs",
    "test:discover": "node scripts/discover-tests.mjs",
    "test:release": "node --test test/unit/*.test.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:release-artifacts": "node scripts/check-release-artifacts.mjs",
    "ci:release": "node scripts/ci.mjs --release",
    "format": "prettier --write .",
    "dev:server": "pnpm --filter @myagentroam/server dev",
    "dev:node": "pnpm --filter @myagentroam/node dev",
    "docs:validate": "node scripts/validate-help-docs.mjs",
    "ci": "node scripts/ci.mjs",
    "release:manifest": "node scripts/release-artifacts.mjs create-product",
    "license": "pnpm --filter @myagentroam/server license",
    "reset-password": "pnpm --filter @myagentroam/server reset-password",
    "test:product": "vitest run --config vitest.config.ts",
    "release:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.14",
    "@eslint/js": "^9.39.1",
    "@vue/server-renderer": "3.5.41",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "mysql2": "^3.23.4",
    "typescript-eslint": "^8.46.4",
    "vitepress": "1.6.4",
    "vue": "3.5.41"
  }
}
