#!/usr/bin/env node
import { spawn } from 'node:child_process';
import { existsSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { basename, dirname, isAbsolute, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { setTimeout } from 'node:timers/promises';

const inactive = 'The bundled playwright-cli requires an active MAR Browser Use environment.';
const root = process.env.MAR_PLAYWRIGHT_CLI_ROOT;
if (!root || !isAbsolute(root) || !/^mpw-[a-f0-9]{32}$/u.test(basename(root))) usageError(inactive);
const active = join(root, 'active');
if (!existsSync(active)) usageError(inactive);
const args = process.argv.slice(2);
// Keep the command unambiguous before delegating command-specific options to Playwright.
let command;
for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === '--') {
    command = args[i + 1];
    break;
  }
  if (!arg.startsWith('-') || arg === '-') {
    command = arg;
    break;
  }
  if (/^(?:--(?:config|session)|-s)(?:=.+)?$/u.test(arg)) {
    if (!arg.includes('=')) {
      const value = args[++i];
      if (!value || value.startsWith('-')) usageError(`Expected a value for ${arg}.`);
    }
  } else if (/^(?:--(?:no-)?(?:all|help|version|json|raw)|-[hv])$/u.test(arg)) {
    if (!arg.startsWith('--no-') && /^(true|false)$/u.test(args[i + 1] ?? '')) i++;
  } else {
    usageError(`Put command-specific options after the Playwright command (${arg}).`);
  }
}
// The pinned CLI does not scope its process-wide kill command to the daemon registry.
if (command === 'kill-all')
  usageError('kill-all is not available in MAR Browser Use. Use close or close-all instead.');

function usageError(message) {
  console.error(message);
  process.exit(1);
}

const require = createRequire(import.meta.url);
const cli = join(dirname(require.resolve('playwright/package.json')), 'cli.js');
const env = { ...process.env };
delete env.MAR_CTL_USER_TOKEN;
// Default runs must not silently reuse an externally configured profile or endpoint.
for (const key of Object.keys(env)) if (/^PLAYWRIGHT_MCP_/iu.test(key)) delete env[key];
env.PWTEST_SERVER_REGISTRY = join(root, 'servers');
const resourceIndex =
  command === 'attach' ? args.findIndex((arg) => arg.startsWith('--mar-resource=')) : -1;
if (resourceIndex !== -1) {
  const id = args[resourceIndex].slice('--mar-resource='.length);
  if (
    !/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u.test(id) ||
    args.filter((arg) => arg.startsWith('--mar-resource=')).length !== 1
  )
    usageError('Use attach --mar-resource=<accessId> with an ID returned by mar_browser.');
  const registry = join(root, `shared-${id}`);
  if (!existsSync(registry))
    usageError('Shared access is no longer available. Acquire it again with mar_browser.');
  env.PWTEST_SERVER_REGISTRY = registry;
  args[resourceIndex] = `--endpoint=${id}`;
}
// These overrides are provided by the bundled version's CLI.
env.PWTEST_DAEMON_SESSION_DIR = join(root, 'd');
env.PWTEST_SOCKETS_DIR = root;
env.PWTEST_CLI_GLOBAL_CONFIG = root;
const separator = args.indexOf('--');
const flags = separator === -1 ? args : args.slice(0, separator);
if (
  (command === 'open' || command === 'attach') &&
  !flags.some((arg) => arg === '--config' || arg.startsWith('--config='))
) {
  const defaultConfig = new URL('./playwright-isolated.json', import.meta.url);
  args.unshift(`--config=${fileURLToPath(defaultConfig)}`);
}
// A Run may finish while a background open/attach is publishing its daemon.
const opensSession = command === 'open' || command === 'attach';
let marker;
let launchLock;
try {
  if (opensSession) launchLock = await lockLaunch();
  if (opensSession || command === 'show') marker = mkdtempSync(join(root, `start-${process.pid}-`));
  if (!existsSync(active)) throw new Error(inactive);
  if (command === 'show') writeFileSync(join(root, 'dashboard-used'), '');
  const preload = new URL('./cancel-launch.mjs', import.meta.url).href;
  const child = spawn(
    process.execPath,
    [...(opensSession ? ['--import', preload] : []), cli, 'cli', ...args],
    { stdio: opensSession ? ['inherit', 'inherit', 'inherit', 'ipc'] : 'inherit', env }
  );
  let cancelled = false;
  const cancelLaunch = () => {
    if (!cancelled && child.connected) {
      cancelled = true;
      child.send('cancel', () => {});
    }
  };
  const check = opensSession
    ? setInterval(() => {
        if (!existsSync(active)) cancelLaunch();
      }, 100)
    : undefined;
  check?.unref();
  const interrupt = () => (opensSession ? cancelLaunch() : child.kill('SIGINT'));
  const terminate = () => (opensSession ? cancelLaunch() : child.kill('SIGTERM'));
  process.on('SIGINT', interrupt);
  process.on('SIGTERM', terminate);
  try {
    const status = await new Promise((resolve, reject) => {
      child.once('error', reject);
      child.once('close', (code) => resolve(code ?? 1));
    });
    process.exitCode = cancelled ? 1 : status;
  } finally {
    clearInterval(check);
    process.off('SIGINT', interrupt);
    process.off('SIGTERM', terminate);
  }
} catch (error) {
  console.error(error.message);
  process.exitCode = 1;
} finally {
  if (marker) rmSync(marker, { force: true, recursive: true });
  if (launchLock) rmSync(launchLock, { force: true, recursive: true });
}

async function lockLaunch() {
  // Playwright checks and publishes its session entry separately; concurrent
  // starts must not create two daemons under the same name.
  const path = join(root, 'launch');
  const deadline = Date.now() + 30_000;
  while (existsSync(active)) {
    try {
      mkdirSync(path, { mode: 0o700 });
      return path;
    } catch (error) {
      if (error.code !== 'EEXIST') throw error;
      if (Date.now() >= deadline) throw new Error('Another Playwright launch did not finish.');
      await setTimeout(50);
    }
  }
  throw new Error(inactive);
}
