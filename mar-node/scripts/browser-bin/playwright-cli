#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import { existsSync, mkdirSync } from 'node:fs';
import { createRequire } from 'node:module';
import { tmpdir } from 'node:os';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const scope = process.env.MAR_PLAYWRIGHT_CLI_SCOPE;
if (!scope || !/^[a-f0-9]{32}$/u.test(scope)) {
  console.error('The bundled playwright-cli requires an active MAR Browser Use environment.');
  process.exit(1);
}
const args = process.argv.slice(2);
// Keep the command unambiguous before delegating command-specific options to Playwright.
let command;
for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === '--') {
    command = args[i + 1];
    break;
  }
  if (!arg.startsWith('-') || arg === '-') {
    command = arg;
    break;
  }
  if (/^(?:--(?:config|session)|-s)(?:=.+)?$/u.test(arg)) {
    if (!arg.includes('=')) {
      const value = args[++i];
      if (!value || value.startsWith('-')) usageError(`Expected a value for ${arg}.`);
    }
  } else if (/^(?:--(?:no-)?(?:all|help|version|json|raw)|-[hv])$/u.test(arg)) {
    if (!arg.startsWith('--no-') && /^(true|false)$/u.test(args[i + 1] ?? '')) i++;
  } else {
    usageError(`Put command-specific options after the Playwright command (${arg}).`);
  }
}
// The pinned CLI does not scope its process-wide kill command to the daemon registry.
if (command === 'kill-all')
  usageError('kill-all is not available in MAR Browser Use. Use close or close-all instead.');

function usageError(message) {
  console.error(message);
  process.exit(1);
}

const require = createRequire(import.meta.url);
const cli = join(dirname(require.resolve('playwright/package.json')), 'cli.js');
const env = { ...process.env };
delete env.MAR_CTL_USER_TOKEN;
// Default runs must not silently reuse an externally configured profile or endpoint.
for (const key of Object.keys(env)) if (/^PLAYWRIGHT_MCP_/iu.test(key)) delete env[key];
const root = join(tmpdir(), `mpw-${scope}`);
mkdirSync(root, { recursive: true, mode: 0o700 });
const resourceIndex =
  command === 'attach' ? args.findIndex((arg) => arg.startsWith('--mar-resource=')) : -1;
if (resourceIndex !== -1) {
  const id = args[resourceIndex].slice('--mar-resource='.length);
  if (
    !/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u.test(id) ||
    args.filter((arg) => arg.startsWith('--mar-resource=')).length !== 1
  )
    usageError('Use attach --mar-resource=<accessId> with an ID returned by mar_browser.');
  const registry = join(root, `shared-${id}`);
  if (!existsSync(registry))
    usageError('Shared access is no longer available. Acquire it again with mar_browser.');
  env.PWTEST_SERVER_REGISTRY = registry;
  args[resourceIndex] = `--endpoint=${id}`;
}
// These overrides are provided by the bundled version's CLI.
env.PWTEST_DAEMON_SESSION_DIR = join(root, 'd');
env.PWTEST_SOCKETS_DIR = root;
env.PWTEST_CLI_GLOBAL_CONFIG = root;
const separator = args.indexOf('--');
const flags = separator === -1 ? args : args.slice(0, separator);
if (
  (command === 'open' || command === 'attach') &&
  !flags.some((arg) => arg === '--config' || arg.startsWith('--config='))
) {
  const defaultConfig = new URL('./playwright-isolated.json', import.meta.url);
  args.unshift(`--config=${fileURLToPath(defaultConfig)}`);
}
const result = spawnSync(process.execPath, [cli, 'cli', ...args], {
  stdio: 'inherit',
  env
});
if (result.error) console.error(result.error.message);
if (result.signal) process.kill(process.pid, result.signal);
process.exitCode = result.status ?? 1;
