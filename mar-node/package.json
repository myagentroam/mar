{
  "name": "@myagentroam/node",
  "version": "0.13.19",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myagentroam/mar.git",
    "directory": "mar-node"
  },
  "description": "MyAgentRoam Node runtime CLI.",
  "license": "Apache-2.0 AND GPL-2.0-or-later",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/terminal-pty-host.mjs",
    "dist/terminal-pty-tree.mjs",
    "dist/marctl/**/*.mjs",
    "dist/marctl/**/*.cjs",
    "dist/marctl/package.json",
    "scripts/install-web-browser.mjs",
    "dist/config.d.ts"
  ],
  "bin": {
    "mar-node": "./dist/main.js",
    "marctl": "./dist/marctl.js",
    "marnodes": "./dist/marnodes.js",
    "marssh": "./dist/marssh.js",
    "marscp": "./dist/marscp.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "node scripts/install-web-browser.mjs",
    "build": "node ../scripts/clean-build-output.mjs dist && tsc -p tsconfig.json && node ../scripts/stage-node-internals.mjs",
    "stage:computer-use-runtime": "node ../scripts/stage-computer-use-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test:unit": "vitest run --config vitest.config.mts && node --test test/unit/*.test.mjs",
    "test:e2e:real": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:computer-use:windows": "node --test test/e2e/computer-use-windows.test.mjs",
    "test:e2e:remote-desktop:windows": "node --test test/e2e/remote-desktop-windows.test.mjs",
    "test:e2e:remote-desktop:macos": "node --test test/e2e/remote-desktop-macos.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.233",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@myagentroam/agent": "workspace:*",
    "@myagentroam/binaries": "workspace:0.10.4",
    "@myagentroam/protocol": "workspace:*",
    "@opencode-ai/sdk": "1.18.20",
    "minimatch": "^10.2.6",
    "node-datachannel": "0.33.4",
    "node-pty": "1.2.0-beta.18",
    "npm": "11.12.1",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "ws": "^8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@myagentroam/code-navigation": "workspace:*",
    "@myagentroam/marctl": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./cli": "./dist/main.js",
    "./package.json": "./package.json"
  }
}
