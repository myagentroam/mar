+    if (previous) CFNumberGetValue(previous, kCFNumberSInt64Type, &native);
+    else if (input && down) {
+        CFNumberRef stored = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &native);
+        CFDictionarySetValue(input->keys, key, stored);
+        CFRelease(stored);
+    }
+    keyboardEvent = CGEventCreateKeyboardEvent(eventSource, (CGKeyCode)(native & 0xffff), down);
+    if (native & (1 << 16)) CGEventKeyboardSetUnicodeString(keyboardEvent, 1, (UniChar*)&keySym);
