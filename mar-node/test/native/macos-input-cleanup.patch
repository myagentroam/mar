+/* Input state belongs to a VNC client and is released when that client leaves. */
+typedef struct {
+    CFMutableDictionaryRef keys;
+    int buttons;
+    int x;
+    int y;
+} ClientInput;
+
+static void firstKey(const void *key, const void *value, void *context)
+{
+    const void **first = context;
+    if (!*first) *first = key;
+}
