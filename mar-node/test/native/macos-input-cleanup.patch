@@ -321,0 +322,14 @@
+/* Input state belongs to a VNC client and is released when that client leaves. */
+typedef struct {
+    CFMutableSetRef keys;
+    int buttons;
+    int x;
+    int y;
+} ClientInput;
+
+static void firstKey(const void *value, void *context)
+{
+    const void **key = context;
+    if (!*key) *key = value;
+}
+
@@ -385,0 +400,8 @@
+    ClientInput *input = cl->clientData;
