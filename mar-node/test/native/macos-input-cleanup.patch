+        int64_t value = keySym;
+        CFNumberRef key = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &value);
+        if (down) CFSetAddValue(input->keys, key);
+        else CFSetRemoveValue(input->keys, key);
+        CFRelease(key);
+    }
@@ -394,0 +417,6 @@
+    ClientInput *input = cl->clientData;
+    if (input) {
+        input->buttons = buttonMask & 7;
+        input->x = x;
+        input->y = y;
+    }
