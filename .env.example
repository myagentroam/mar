# Copy to .env in an administrator-only deployment directory, then fill every required value.
# Never commit .env. See docs/help/en-US/getting-started/server-installation.md.
MAR_PUBLIC_ORIGIN=https://mar.example.com
# HTTP origins are supported too (for example http://192.168.1.10:5190).
# Bind to 0.0.0.0 for direct external access, or keep loopback behind a proxy.
MAR_SERVER_BIND_ADDRESS=127.0.0.1
MAR_SERVER_PUBLIC_PORT=5190
# Optional VAPID contact: mailto:admin@example.com or an HTTPS URL.
# Required to use Push with an HTTP site; HTTPS sites default to their public origin.
MAR_WEB_PUSH_SUBJECT=
MAR_MYSQL_ROOT_PASSWORD=
# Use a strong URL-safe password: this value is also embedded in MAR_DATABASE_URL.
MAR_MYSQL_PASSWORD=
MAR_MYSQL_DATABASE=myagentroam
MAR_MYSQL_USER=myagentroam
MAR_SEARXNG_SECRET=
# Absolute path to an existing, protected directory; an empty directory is allowed.
MAR_SERVER_SSH_DIR=
