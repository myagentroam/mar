# Copy to .env in an administrator-only deployment directory, then fill every blank.
# Never commit .env. See docs/help/en-US/getting-started/server-installation.md.
MAR_PUBLIC_ORIGIN=https://mar.example.com
MAR_MYSQL_ROOT_PASSWORD=
# Use a strong URL-safe password: this value is also embedded in MAR_DATABASE_URL.
MAR_MYSQL_PASSWORD=
MAR_MYSQL_DATABASE=myagentroam
MAR_MYSQL_USER=myagentroam
MAR_SEARXNG_SECRET=
# Absolute path to an existing, protected directory; an empty directory is allowed.
MAR_SERVER_SSH_DIR=
