+/* Input state belongs to a VNC client and is released when that client leaves. */
+typedef struct {
+    CFMutableDictionaryRef keys;
+    int buttons;
+    int x;
+    int y;
+} ClientInput;
+
+static void firstKey(const void *key, const void *value, void *context)
+{
+    const void **first = context;
+    if (!*first) *first = key;
+}
+
+/* The event source can lag posted key events; use this client's held keys. */
+static void heldModifier(const void *key, const void *value, void *context)
+{
+    int64_t symbol = 0;
+    CGEventFlags *flags = context;
+    CFNumberGetValue(key, kCFNumberSInt64Type, &symbol);
+    switch (symbol) {
+        case XK_Shift_L: case XK_Shift_R: *flags |= kCGEventFlagMaskShift; break;
+        case XK_Control_L: case XK_Control_R: *flags |= kCGEventFlagMaskControl; break;
+        case XK_Meta_L: case XK_Meta_R: case XK_ISO_Level3_Shift: case XK_Mode_switch:
+            *flags |= kCGEventFlagMaskAlternate; break;
+        case XK_Alt_L: case XK_Alt_R: case XK_Super_L: *flags |= kCGEventFlagMaskCommand; break;
+    }
+}
