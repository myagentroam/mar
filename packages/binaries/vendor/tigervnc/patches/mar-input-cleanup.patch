+static bool initMarControl()
+{
+  const char* value = getenv("MAR_RFB_CONTROL_FD");
+  if (!value)
+    return true;
+  char* end = nullptr;
+  errno = 0;
+  long fd = strtol(value, &end, 10);
+  int type = 0;
+  socklen_t typeLen = sizeof(type);
+  sockaddr_storage peer = {};
+  socklen_t peerLen = sizeof(peer);
+  if (errno || !*value || *end || fd < 3 || fd >= FD_SETSIZE ||
+      getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &typeLen) ||
+      type != SOCK_STREAM || getpeername(fd, (sockaddr*)&peer, &peerLen) ||
+      peer.ss_family != AF_UNIX)
+    return false;
+  int flags = fcntl(fd, F_GETFD);
+  if (flags < 0 || fcntl(fd, F_SETFD, flags | FD_CLOEXEC) < 0)
+    return false;
+  marControlFd = static_cast<int>(fd);
+  marManaged = true;
+  return true;
+}
+
+static void sendMarCleanup(const uint32_t token[4], bool ok)
+{
+  if (marControlFd < 0)
+    return;
+  char message[64];
+  int len = snprintf(message, sizeof(message), "MAR1 %08x%08x%08x%08x %s\n",
+                     token[0], token[1], token[2], token[3], ok ? "OK" : "FAILED");
+  // A missing, short, or congested control channel fails closed at Node.
+  if (send(marControlFd, message, len, MSG_DONTWAIT | MSG_NOSIGNAL) != len) {
+    close(marControlFd);
+    marControlFd = -1;
+    marControlLost = true;
+  }
+}
 
