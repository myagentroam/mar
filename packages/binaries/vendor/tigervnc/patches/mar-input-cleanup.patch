+// MAR's private registration is consumed only between its Node and the local
+// managed backend. Browser-provided encodings never reach this marker.
+void VNCSConnectionST::setEncodings(int count, const int32_t* encodings)
+{
+  if (count > 0 && encodings[0] == 0x4d415231) {
+    if (count != 5 || marAttachmentRegistered) {
+      close("Invalid MAR attachment registration");
+      return;
+    }
+    for (int i = 0; i < 4; i++)
+      marAttachmentToken[i] = static_cast<uint32_t>(encodings[i + 1]);
+    marAttachmentRegistered = true;
+    return;
+  }
+  SConnection::setEncodings(count, encodings);
+}
+
+bool VNCSConnectionST::marAttachment(uint32_t token[4]) const
+{
+  if (!marAttachmentRegistered)
+    return false;
+  for (int i = 0; i < 4; i++)
+    token[i] = marAttachmentToken[i];
+  return true;
+}
