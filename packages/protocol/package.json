{
  "name": "@myagentroam/protocol",
  "version": "0.15.30",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myagentroam/mar.git",
    "directory": "packages/protocol"
  },
  "description": "Shared runtime protocol schemas for MyAgentRoam.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./tcp-forward": {
      "development": "./src/tcp-forward.ts",
      "types": "./dist/tcp-forward.d.ts",
      "import": "./dist/tcp-forward.js"
    },
    "./browser-stream": {
      "development": "./src/browser-stream.ts",
      "types": "./dist/browser-stream.d.ts",
      "import": "./dist/browser-stream.js"
    },
    "./node-stream": {
      "development": "./src/node-stream.ts",
      "types": "./dist/node-stream.d.ts",
      "import": "./dist/node-stream.js"
    },
    "./file-upload-stream": {
      "development": "./src/file-upload-stream.ts",
      "types": "./dist/file-upload-stream.d.ts",
      "import": "./dist/file-upload-stream.js"
    },
    "./terminal-stream": {
      "development": "./src/terminal-stream.ts",
      "types": "./dist/terminal-stream.d.ts",
      "import": "./dist/terminal-stream.js"
    },
    "./package.json": "./package.json",
    "./byte-frame": {
      "types": "./dist/byte-frame.d.ts",
      "import": "./dist/byte-frame.js"
    },
    "./node-connection": {
      "development": "./src/node-connection.ts",
      "types": "./dist/node-connection.d.ts",
      "import": "./dist/node-connection.js"
    },
    "./node-relay-path": {
      "development": "./src/node-relay-path.ts",
      "types": "./dist/node-relay-path.d.ts",
      "import": "./dist/node-relay-path.js"
    },
    "./node-stream-mux": {
      "development": "./src/node-stream-mux.ts",
      "types": "./dist/node-stream-mux.d.ts",
      "import": "./dist/node-stream-mux.js"
    },
    "./node-stream-path": {
      "development": "./src/node-stream-path.ts",
      "types": "./dist/node-stream-path.d.ts",
      "import": "./dist/node-stream-path.js"
    },
    "./node-stream-wire": {
      "development": "./src/node-stream-wire.ts",
      "types": "./dist/node-stream-wire.d.ts",
      "import": "./dist/node-stream-wire.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-build-output.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:unit": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
