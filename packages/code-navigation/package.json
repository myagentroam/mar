{
  "name": "@myagentroam/code-navigation",
  "version": "0.11.0",
  "description": "Shared pure language detection and file-reference extraction for MyAgentRoam.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./symbol-navigation": {
      "types": "./dist/symbol-navigation.d.ts",
      "import": "./dist/symbol-navigation.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-build-output.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:unit": "vitest run --config vitest.config.mts"
  }
}
