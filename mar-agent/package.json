{
  "name": "@myagentroam/agent",
  "version": "0.11.74",
  "description": "Embeddable MAR coding agent SDK and CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sandbox/linux": {
      "types": "./dist/sandbox/linux/index.d.ts",
      "default": "./dist/sandbox/linux/index.js"
    },
    "./host/network": {
      "types": "./dist/host/network.d.ts",
      "default": "./dist/host/network.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "default": "./dist/extensions.js"
    },
    "./session-store": {
      "types": "./dist/session-store.d.ts",
      "default": "./dist/session-store.js"
    }
  },
  "bin": {
    "maragent": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../scripts/clean-build-output.mjs dist && tsc -p tsconfig.json && tsc -p extensions/subagent/tsconfig.json --outDir dist/cli/subagent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm build && vitest run --config vitest.config.ts test/unit",
    "analyze:session": "node test/tools/session-analyzer.mjs",
    "benchmark:compaction": "node test/e2e/compaction-benchmark.mjs",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:memory": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.memory.config.ts",
    "test:e2e": "vitest run --config vitest.config.ts test/e2e --no-file-parallelism",
    "test": "pnpm test:unit",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "sharp": "0.35.5",
    "undici": "7.29.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "vitest": "^4.0.14"
  }
}
