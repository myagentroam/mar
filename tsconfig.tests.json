{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "paths": { "element-plus": ["./ee/web/node_modules/element-plus/es/index.d.ts"] },
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.mts",
    "ee/*/test/unit/**/*.ts",
    "vitest.config.ts",
    "playwright.config.mts",
    "mar-node/src/service/turndown-plugin-gfm.d.ts",
    "ee/web/src/vite-env.d.ts",
    "packages/web-core/test/unit/support/component-fixtures.d.ts",
    "packages/web-core/test/e2e/management-page-app.ts"
  ],
  "exclude": ["test/runs"]
}
