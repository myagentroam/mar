{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../ee/web/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts",
    "../packages/web-core/src/**/*.d.ts",
    "../ee/web/src/**/*.d.ts"
  ]
}
